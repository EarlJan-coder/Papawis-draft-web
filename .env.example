# PostgreSQL connection string (the app: local Docker or cloud Neon).
# Local dev (Docker): postgres://papawis:papawis@localhost:5433/papawis
# Neon (pooled endpoint): postgres://<user>:<password>@<endpoint>-pooler.<region>.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Used by integration tests + E2E; point at a DISPOSABLE Postgres database.
# Suites create sibling DBs (papawis_test / papawis_e2e) on the server this
# points at — keep it local (e.g. postgres://papawis:papawis@localhost:5433/papawis_test)
# so tests can never TRUNCATE a cloud database when DATABASE_URL is Neon.
# Falls back to a sibling on DATABASE_URL's server when unset (CI).
TEST_DATABASE_URL=

# Better Auth - generate with: npx @better-auth/cli secret
# PUBLIC URL of the app (no trailing slash)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Configurable league branding (no hardcoded league names in the codebase).
LEAGUE_NAME=Papawis League

# Optional: first organizer email, provisioned by `npm run provision:organizer`
SEED_ORGANIZER_EMAIL=
